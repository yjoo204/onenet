<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="冷库温度控制系统"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ibtn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:srcCompat="@android:drawable/ic_menu_manage" />
    </LinearLayout>

    <!-- 人员状态 + 温度环形进度条 + LED状态 一行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tv_person_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="无人"
            android:background="@drawable/rounded_corner_background"
            android:padding="12dp" />

        <com.mikhaellopez.circularprogressbar.CircularProgressBar
            android:id="@+id/circularProgressBar"
            android:layout_width="125dp"
            android:layout_height="140dp"
            app:cpb_background_progressbar_color="#b6bbd8"
            app:cpb_background_progressbar_width="5dp"
            app:cpb_progress_direction="to_left"
            app:cpb_progress_max="100"
            app:cpb_progressbar_color="@color/red"
            app:cpb_progressbar_width="5dp"
            app:cpb_round_border="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_led_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="灯光已开"
            android:background="@drawable/rounded_corner_background"
            android:padding="12dp" />
    </LinearLayout>

    <!-- 监测标题 -->
    <TextView
        android:id="@+id/tv_monitor_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="冷库温度监测"
        android:layout_marginTop="0dp" />

    <!-- 第一行：湿度 + 温度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="0dp">

        <!-- 湿度显示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:background="@drawable/rounded_corner_background"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/iv_humidity"
                android:layout_width="35dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/hum" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_humidity_value"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="20"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_humidity_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="湿度(%)"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>

        <!-- 温度显示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_corner_background"
            android:padding="12dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/iv_temperature"
                android:layout_width="35dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/temp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_temperature_value"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="123"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_temperature_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="温度(℃)"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- 第二行：烟雾浓度 + 光照 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="16dp">

        <!-- 烟雾浓度显示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_corner_background"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/iv_smoke"
                android:layout_width="35dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/smokedensity" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_smoke_value"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="123"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_smoke_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="烟雾浓度(ppm)"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>

        <!-- 光照显示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_corner_background"
            android:padding="12dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/iv_light"
                android:layout_width="35dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_light_value"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="123"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_light_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="光照(lux)"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_corner_background"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/iv_led"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/led" />

            <Switch
                android:id="@+id/switch_led"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="LED开关" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_corner_background"
            android:padding="12dp"
            android:layout_marginStart="8dp">
            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/smokedensity" />

            <Switch
                android:id="@+id/switch2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="风扇开关" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>