<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            app:srcCompat="@drawable/__" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="冷库安全监测系统"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_admin_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/yuanjiao"
            android:gravity="center"
            android:text="管"
            android:textColor="#2563EB"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_admin_greeting"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="管理员你好"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cold_storage_name"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="冷库"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_switch_storage"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="190dp"
            android:gravity="center"
            android:text="切换 >"
            android:textColor="#3B82F6"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:weightSum="2">

        <!-- 湿度显示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_corner_background"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_humidity_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="当前湿度"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_humidity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="20" />

                <TextView
                    android:id="@+id/tv_humidity_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="25sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_humidity_status"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    app:srcCompat="?android:attr/textCursorDrawable" />

                <TextView
                    android:id="@+id/tv_humidity_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正常(阈值:40%~60%)"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_corner_background"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_temperature_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="当前温度"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_temperature_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="-18" />

                <TextView
                    android:id="@+id/tv_temperature_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="℃"
                    android:textSize="25sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_temperature_status"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    app:srcCompat="?android:attr/textCursorDrawable" />

                <TextView
                    android:id="@+id/tv_temperature_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正常 (阈值：-20~-15℃)"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- 温度显示 -->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:weightSum="2">

        <!-- 烟雾浓度显示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_corner_background"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_smoke_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="烟雾浓度"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_smoke_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="0.3" />

                <TextView
                    android:id="@+id/tv_smoke_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mg/m³"
                    android:textSize="25sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_smoke_status"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    app:srcCompat="?android:attr/textCursorDrawable" />

                <TextView
                    android:id="@+id/tv_smoke_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正常 (阈值：≤0.5mg/m³)"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- 安全状态显示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_corner_background"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_safety_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="安全状态"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_safety_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="35sp"
                    android:textStyle="bold"
                    tools:text="安全" />

                <TextView
                    android:id="@+id/tv_safety_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="25sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_safety_icon"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    app:srcCompat="?android:attr/textCursorDrawable" />

                <TextView
                    android:id="@+id/tv_safety_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="无人员 | 库门关闭"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- 温度显示 -->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:background="@drawable/rounded_corner_background"
        android:orientation="vertical"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:padding="12dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/tv_device_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备状态"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="85dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_fan_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/yuanjiao1"
                    app:srcCompat="@drawable/smokedensity" />

                <TextView
                    android:id="@+id/tv_fan_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:text="散热风扇" />

                <TextView
                    android:id="@+id/tv_fan_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/yuanjiao2"
                    android:gravity="center"
                    android:textColor="#10B981"
                    tools:text="已开启" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="85dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_light_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/yuanjiao1"
                    app:srcCompat="@drawable/led" />

                <TextView
                    android:id="@+id/tv_light_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:text="照明系统" />

                <TextView
                    android:id="@+id/tv_light_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/yuanjiao2"
                    android:gravity="center"
                    android:textColor="#10B981"
                    tools:text="运行中" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_door_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/yuanjiao1"
                    app:srcCompat="@drawable/sahng" />

                <TextView
                    android:id="@+id/tv_door_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:text="库门" />

                <TextView
                    android:id="@+id/tv_door_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/yuanjiao1"
                    android:gravity="center"
                    tools:text="关闭"
                    tools:textColor="#1F2937" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
